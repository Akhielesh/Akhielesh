# ─────────────────────────────────────────────────────────────
# Adminak configuration. Copy to `.env` and fill in what you need.
# Everything except APP_URL is optional for a first local run.
# ─────────────────────────────────────────────────────────────

# Public URL of this instance (used in email links + OAuth redirect).
APP_URL=http://localhost:8787
PORT=8787

# Where the SQLite database and generated keys live. Mount this as a volume in production.
DATA_DIR=./data

# 32+ random characters. Encrypts stored mailbox credentials and tokens.
# If omitted, one is generated into DATA_DIR/secret.key on first boot. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# Optional: create the admin account automatically on first boot
# (otherwise open the app and use the one-time setup code printed in the logs).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Set to true when running behind a reverse proxy (Railway, Fly, Render, Nginx, Cloudflare).
TRUST_PROXY=false

# ── Gmail API (recommended for Gmail) ──────────────────────────
# Create an OAuth client (type: Web application) at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${APP_URL}/api/accounts/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Outgoing email (alerts, digests, reports) ──────────────────
# Any SMTP provider works: Gmail (app password), Fastmail, Resend, Postmark, SES, SendGrid…
# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true SMTP_USER=you@gmail.com SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Adminak <alerts@example.com>"
# Default recipient for alerts (you can add more in Notifications → Channels).
NOTIFY_EMAIL=

# ── Optional AI layer (Claude) ─────────────────────────────────
# Enables smarter classification of ambiguous emails, the daily briefing, and "Ask Adminak".
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Default minutes between mailbox scans (also editable in Settings).
SYNC_INTERVAL_MINUTES=5

LOG_LEVEL=info
